/* 4-7. 계약직 계약현황 (3p) — 직급코드 첫 글자 'G'인 인원만 자동 필터링,
   계약시작일·계약만료예정일은 명부에 없어 수기 입력 → state.contractDates에 보관 */
function getContractEmployees(active){
  return active
    .filter(r => (r['직급코드']||'').trim().charAt(0) === 'G')
    .map(r => ({ id: r['사번'], name: r['성명'], org: r['원소속부서'], title: r['직위코드명'] || r['직급명'] || '-' }))
    .sort((a,b) => a.org.localeCompare(b.org,'ko') || a.name.localeCompare(b.name,'ko'));
}

function renderContractCard(active){
  const people = getContractEmployees(active);

  if(people.length === 0){
    document.getElementById('contractContent').innerHTML = '<div class="empty-state">직급코드 G로 시작하는 계약직 인원이 없습니다</div>';
    document.getElementById('contractNote').textContent = '총 0명';
    return;
  }

  const today = baseDate();
  const rows = people.map(p => {
    const saved = state.contractDates[p.id] || {};
    const endDate = parseYMD(saved.end);
    const isSoon = endDate && (endDate - today) / (1000*60*60*24) <= 60 && (endDate - today) >= 0;
    const isPast = endDate && endDate < today;
    return `<tr${isPast ? ' style="background:#FDEDE8;"' : (isSoon ? ' style="background:#FDF3E7;"' : '')}>
      <td>${p.name}</td>
      <td>${p.org}</td>
      <td>${p.title}</td>
      <td><input type="date" value="${saved.start || ''}" onchange="onContractDateChange('${esc(p.id)}','start',this.value)" style="font-size:11px;padding:3px;"/></td>
      <td><input type="date" value="${saved.end || ''}" onchange="onContractDateChange('${esc(p.id)}','end',this.value)" style="font-size:11px;padding:3px;"/></td>
    </tr>`;
  }).join('');

  document.getElementById('contractContent').innerHTML = `
    <table class="tbl">
      <tr><th>성명</th><th>원소속부서</th><th>직위</th><th>계약시작일</th><th>계약만료예정일</th></tr>
      ${rows}
    </table>`;

  const soonCount = people.filter(p => {
    const d = parseYMD((state.contractDates[p.id]||{}).end);
    return d && (d - today) / (1000*60*60*24) <= 60 && (d - today) >= 0;
  }).length;
  document.getElementById('contractNote').textContent =
    `총 ${people.length}명(직급코드 G 기준)` + (soonCount ? ` · 60일 이내 만료 ${soonCount}명` : '') + ' · 날짜는 직접 입력, 저장 시 파일에 함께 보관됩니다';
}

function onContractDateChange(empId, field, value){
  state.contractDates[empId] = state.contractDates[empId] || {};
  state.contractDates[empId][field] = value;
  renderContractCard(state.curr.filter(r => isMarine(r['원소속부서']) && r['재직상태']==='재직'));
}
