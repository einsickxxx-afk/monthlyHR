function renderDeptCard(active){
  const groupData = {};
  GROUP_ORDER.forEach(g => groupData[g] = {});
  active.forEach(r => {
    const g = groupOf(r['원소속부서']);
    if(!groupData[g]) groupData[g] = {};
    const org = r['원소속부서'];
    groupData[g][org] = (groupData[g][org]||0) + 1;
  });

  const [c1,c2] = themeColors();
  const groupColor = { '직속조직': c1, '해양연구소': mix(c1,'#000000',0.32), 'SV사업센터': c2 };

  let html = '';
  GROUP_ORDER.forEach(g => {
    const entries = Object.entries(groupData[g] || {}).sort((a,b)=> a[0].localeCompare(b[0],'ko'));
    if(entries.length === 0) return;
    const subtotal = entries.reduce((a,[,v])=>a+v,0);
    html += `<div class="dept-group-head"><span>${g}</span><b>${subtotal}명</b></div>`;
    html += `<div class="dept-tile-grid">` + entries.map(([label,value]) => `
      <div class="dept-tile" style="border-left-color:${groupColor[g]}">
        <div class="dept-tile-count">${value}<span>명</span></div>
        <div class="dept-tile-name">${label}</div>
      </div>`).join('') + `</div>`;
  });

  document.getElementById('deptContent').innerHTML = html;

  const groupCounts = {};
  active.forEach(r => { const g = groupOf(r['원소속부서']); groupCounts[g] = (groupCounts[g]||0)+1; });
  document.getElementById('deptNote').textContent =
    GROUP_ORDER.filter(g=>groupCounts[g]).map(g => `${g} ${groupCounts[g]}명`).join(' · ');
}
