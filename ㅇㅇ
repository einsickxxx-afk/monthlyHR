/* 4-6. 정년·임금피크 예측 (3p) — 연도별 막대(정년)+꺾은선(임금피크) 복합 차트 */
function calcWagePeakDate(birth){
  const turn = new Date(birth.getFullYear()+57, birth.getMonth(), birth.getDate());
  return new Date(turn.getFullYear(), turn.getMonth()+1, 1);
}
function calcRetireDate(birth){
  const turn = new Date(birth.getFullYear()+60, birth.getMonth(), birth.getDate());
  return new Date(turn.getFullYear(), turn.getMonth()+1, 0);
}
// 근속연수는 팀별 평균 근속연수 카드와 동일하게 그룹입사일 기준으로 계산합니다.
function groupTenureYears(row, baseDate){
  const digits = (row['그룹입사일']||'').replace(/[^0-9]/g,'');
  if(digits.length < 8) return null;
  const y=+digits.slice(0,4), m=+digits.slice(4,6)-1, d=+digits.slice(6,8);
  const joined = new Date(y,m,d);
  if(isNaN(joined.getTime())) return null;
  return (baseDate - joined) / (1000*60*60*24*365.25);
}

// 향후 10개 연도(캘린더 연도 기준) 각각에 대해 정년·임금피크 도래 인원을 집계합니다.
function countRetireYearly(active, baseDate){
  const startYear = baseDate.getFullYear();
  const years = Array.from({length:10}, (_,i) => startYear + i);
  const retireCounts = {}, wagePeakCounts = {}, retirePeople = {}, wagePeakPeople = {};
  years.forEach(y => { retireCounts[y]=0; wagePeakCounts[y]=0; retirePeople[y]=[]; wagePeakPeople[y]=[]; });

  active.filter(r => !isExec(r)).forEach(row => {
    const birth = parseYMD(row['법정생년월일']);
    if(!birth) return;
    const tenure = groupTenureYears(row, baseDate);
    const person = { name: row['성명'], org: row['원소속부서'], title: row['직위코드명'] || '-', tenure, birth };

    const wp = calcWagePeakDate(birth);
    if(wp > baseDate && years.includes(wp.getFullYear())){
      wagePeakCounts[wp.getFullYear()]++;
      wagePeakPeople[wp.getFullYear()].push({ ...person, arriveDate: wp });
    }
    const rt = calcRetireDate(birth);
    if(rt > baseDate && years.includes(rt.getFullYear())){
      retireCounts[rt.getFullYear()]++;
      retirePeople[rt.getFullYear()].push({ ...person, arriveDate: rt });
    }
  });
  return { years, retireCounts, wagePeakCounts, retirePeople, wagePeakPeople };
}

function renderRetireForecastCard(active){
  const base = baseDate();
  const forecast = countRetireYearly(active, base);
  window.__retireForecast = forecast;

  document.getElementById('retireForecastContent').innerHTML = buildRetireComboChart(forecast);
  document.getElementById('retireForecastNote').textContent =
    `기준일 ${fmtYMD(base)} · 막대=정년(만60세 도달월 말일), 꺾은선=임금피크(만57세 도달월 익월1일) · 임원 제외 · 막대/점 클릭 시 명단 표시`;
}

function buildRetireComboChart(forecast){
  const { years, retireCounts, wagePeakCounts } = forecast;
  const BAR_W = 30, GAP = 20, LEFT = 46, RIGHT = 16, TOP = 20, CHART_H = 200, BOTTOM = 34;
  const totalW = LEFT + RIGHT + years.length*(BAR_W+GAP) - GAP;
  const totalH = TOP + CHART_H + BOTTOM;

  const maxVal = Math.max(1, ...years.map(y => Math.max(retireCounts[y], wagePeakCounts[y])));
  const niceMax = Math.ceil(maxVal/5)*5 || 5;
  const yOf = v => TOP + CHART_H - (v/niceMax)*CHART_H;
  const baseline = TOP + CHART_H;

  let svg = '';
  [0, niceMax/2, niceMax].forEach(v => {
    const y = yOf(v);
    svg += `<line x1="${LEFT}" y1="${y}" x2="${totalW-RIGHT}" y2="${y}" stroke="#EEF1F6" stroke-width="1"/>`;
    svg += `<text x="${LEFT-8}" y="${y+3}" text-anchor="end" font-size="9" fill="#98A2B3">${Math.round(v)}</text>`;
  });

  const centers = years.map((y,i) => LEFT + i*(BAR_W+GAP) + BAR_W/2);

  years.forEach((y,i) => {
    const cx = centers[i];
    const v = retireCounts[y];
    const h = baseline - yOf(v);
    svg += `<g class="org-node" style="cursor:pointer;" onclick="toggleRetireTooltip(event,${y},'retire')">
      <rect x="${cx-BAR_W/2}" y="${yOf(v)}" width="${BAR_W}" height="${h}" rx="3" fill="#2F6FED" opacity="0.85"/>
      ${v>0 ? `<text x="${cx}" y="${yOf(v)-6}" text-anchor="middle" font-size="10" font-weight="700" fill="#2F6FED">${v}</text>` : ''}
    </g>`;
  });

  const linePts = years.map((y,i) => `${centers[i]},${yOf(wagePeakCounts[y])}`).join(' ');
  svg += `<polyline points="${linePts}" fill="none" stroke="#C6431E" stroke-width="2"/>`;
  years.forEach((y,i) => {
    const cx = centers[i], cy = yOf(wagePeakCounts[y]), v = wagePeakCounts[y];
    svg += `<g class="org-node" style="cursor:pointer;" onclick="toggleRetireTooltip(event,${y},'wagePeak')">
      <circle cx="${cx}" cy="${cy}" r="4.5" fill="#C6431E"/>
      ${v>0 ? `<text x="${cx}" y="${cy-10}" text-anchor="middle" font-size="10" font-weight="700" fill="#C6431E">${v}</text>` : ''}
    </g>`;
  });

  years.forEach((y,i) => {
    svg += `<text x="${centers[i]}" y="${baseline+18}" text-anchor="middle" font-size="10" fill="#475467">${y}</text>`;
  });

  const legend = `
    <div style="display:flex;gap:14px;font-size:11px;color:#344054;margin-bottom:6px;">
      <span><i style="display:inline-block;width:10px;height:10px;background:#2F6FED;border-radius:2px;margin-right:4px;"></i>정년 예정(명)</span>
      <span><i style="display:inline-block;width:10px;height:10px;background:#C6431E;border-radius:50%;margin-right:4px;"></i>임금피크 도래(명)</span>
    </div>`;

  return legend +
    `<svg viewBox="0 0 ${totalW} ${totalH}" width="${totalW}" height="${totalH}" style="width:100%;height:auto;display:block;">${svg}</svg>` +
    `<div id="retireTooltip" class="flow-tooltip" style="display:none;"></div>`;
}

// 막대(정년) 또는 점(임금피크)을 클릭하면 해당 연도 해당 유형 대상자 명단을 보여줍니다.
function toggleRetireTooltip(e, year, type){
  const tip = document.getElementById('retireTooltip');
  if(!tip) return;
  const key = year + ':' + type;

  if(tip.dataset.key === key && tip.style.display !== 'none'){
    tip.style.display = 'none';
    tip.dataset.key = '';
    return;
  }

  const forecast = window.__retireForecast;
  const people = (type === 'retire' ? forecast.retirePeople[year] : forecast.wagePeakPeople[year]) || [];
  const typeLabel = type === 'retire' ? '정년' : '임금피크';

  const body = people.length
    ? people.map(p => `
        <div style="margin-top:6px;padding-top:6px;border-top:1px dashed var(--border);">
          <div style="font-weight:700;">${p.name}(${p.org}, ${p.title})</div>
          <div style="color:var(--mute);font-size:10.5px;">근속연수 ${p.tenure!=null ? p.tenure.toFixed(1)+'년' : '-'} · 생년월일 ${fmtYMD(p.birth)} · ${typeLabel} 도래일 ${fmtYMD(p.arriveDate)}</div>
        </div>`).join('')
    : '<div style="color:#999;margin-top:4px;">해당 인원 없음</div>';

  tip.innerHTML = `<div style="font-weight:700;">${year}년 · ${typeLabel} (${people.length}명)</div>` + body;

  const rect = e.currentTarget.getBoundingClientRect();
  tip.style.left = (rect.left + window.scrollX) + 'px';
  tip.style.top = (rect.bottom + window.scrollY + 6) + 'px';
  tip.style.display = 'block';
  tip.dataset.key = key;
}
document.addEventListener('click', function(e){
  const tip = document.getElementById('retireTooltip');
  if(!tip) return;
  if(!tip.contains(e.target) && !e.target.closest('#retireForecastContent svg')){
    tip.style.display = 'none';
    tip.dataset.key = '';
  }
});
