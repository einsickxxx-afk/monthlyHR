function handleFlowCsv(file){
  if(!file) return;
  document.getElementById('flowFname').textContent = file.name;
  const reader = new FileReader();
  reader.onload = e => parseFlowCsv(e.target.result);
  reader.readAsText(file, 'UTF-8');
}

function parseFlowCsv(text){
  const lines = text.split(/\r?\n/).map(l => l.trim()).filter(Boolean);
  const data = {};
  lines.slice(1).forEach(line => {
    const [key, val] = line.split(',').map(s => s.trim());
    if(key) data[key] = Number(val);
  });
  updateFlowCard(data);
}

function updateFlowCard(data){
  const prev = data['전월인원'] ?? 0;
  const curr = data['당월인원'] ?? 0;
  const diff = curr - prev;

  document.getElementById('flowPrev').textContent = prev + '명';
  document.getElementById('flowCurr').textContent = curr + '명';

  const diffEl = document.getElementById('flowDiff');
  diffEl.textContent = (diff >= 0 ? '▲ ' : '▼ ') + Math.abs(diff) + '명';
  diffEl.style.background = diff >= 0 ? '#E6F7F2' : '#FDEDE8';
  diffEl.style.color = diff >= 0 ? '#16876F' : '#C6431E';

  const cats = ['채용','복직','전입','퇴직','휴직','전출'];
  const maxAbs = Math.max(1, ...cats.map(c => Math.abs(data[c] ?? 0)));

  cats.forEach(c => {
    const v = data[c] ?? 0;
    const bar = document.getElementById('bar-' + c);
    const valEl = document.getElementById('val-' + c);
    const pct = Math.max(4, Math.round(Math.abs(v) / maxAbs * 100));
    bar.style.height = pct + '%';
    bar.classList.toggle('neg', v < 0);
    valEl.textContent = v;
  });
}
